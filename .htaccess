# vue-router の history mode 用。
# 実在するファイル・ディレクトリはそのまま返し、それ以外は index.html に渡す。
# これが無いと /shvlang を直接開いた時や404ページでサーバの404が出てしまう。
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /

    # SSL証明書の発行・更新で使われる場所。ここを index.html に渡してしまうと
    # 確認が通らず証明書が出ないので、書き換えの対象から先に外す
    RewriteRule ^\.well-known/ - [L]

    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    RewriteRule ^ index.html [L]
</IfModule>
